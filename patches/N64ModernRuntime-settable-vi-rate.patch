+// Microseconds between vertical retraces. speed_multiplier is an integer, so it
+// can only ever make the machine faster; a game that paces itself off retrace
+// and was tuned for hardware that could not sustain 60 Hz needs the opposite.
+// Zero restores the original rate.
+static std::atomic<uint64_t> vi_period_us{1000000 / (60 * speed_multiplier)};
+
+uint64_t ultramodern::get_vi_period_us() {
+    return vi_period_us.load(std::memory_order_relaxed);
+}
+
+void ultramodern::set_vi_period_us(uint64_t period_us) {
+    vi_period_us.store(period_us != 0 ? period_us : 1000000 / (60 * speed_multiplier),
+                       std::memory_order_relaxed);
+}
+
 std::chrono::high_resolution_clock::time_point ultramodern::get_start() {
     return start_time;
 }
