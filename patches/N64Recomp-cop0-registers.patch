diff --git a/include/recomp.h b/include/recomp.h
--- a/include/recomp.h
+++ b/include/recomp.h
@@ -423,6 +423,7 @@ typedef struct {
     uint64_t hi, lo;
     uint32_t* f_odd;
     uint32_t status_reg;
+    uint32_t cop0_regs[32];
     uint8_t mips3_float_mode;
 } recomp_context;
 
@@ -436,6 +437,22 @@ extern "C" {
 
 void cop0_status_write(recomp_context* ctx, gpr value);
 gpr cop0_status_read(recomp_context* ctx);
+
+static inline gpr cop0_read(recomp_context* ctx, uint32_t reg) {
+    if (reg == 12) {
+        return cop0_status_read(ctx);
+    }
+    return (gpr)(int32_t)ctx->cop0_regs[reg & 31];
+}
+
+static inline void cop0_write(recomp_context* ctx, uint32_t reg, gpr value) {
+    if (reg == 12) {
+        cop0_status_write(ctx, value);
+        return;
+    }
+    ctx->cop0_regs[reg & 31] = (uint32_t)value;
+}
+
 void switch_error(const char* func, uint32_t vram, uint32_t jtbl);
 void do_break(uint32_t vram);
 
diff --git a/src/recompilation.cpp b/src/recompilation.cpp
--- a/src/recompilation.cpp
+++ b/src/recompilation.cpp
@@ -424,8 +424,11 @@ bool process_instruction(GeneratorType& generator, const N64Recomp::Context& con
                 generator.emit_cop0_status_read(rt);
                 break;
             default:
-                fmt::print(stderr, "Unhandled cop0 register in mfc0: {}\n", (int)reg);
-                return false;
+                if (rt != 0) {
+                    print_indent();
+                    fmt::print(output_file, "{}{} = cop0_read(ctx, {});\n", ctx_gpr_prefix(rt), rt, (int)reg);
+                }
+                break;
             }
             break;
         }
@@ -438,8 +441,9 @@ bool process_instruction(GeneratorType& generator, const N64Recomp::Context& con
                 generator.emit_cop0_status_write(rt);
                 break;
             default:
-                fmt::print(stderr, "Unhandled cop0 register in mtc0: {}\n", (int)reg);
-                return false;
+                print_indent();
+                fmt::print(output_file, "cop0_write(ctx, {}, {}{});\n", (int)reg, ctx_gpr_prefix(rt), rt);
+                break;
             }
             break;
         }
