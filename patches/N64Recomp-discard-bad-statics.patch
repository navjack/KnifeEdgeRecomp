diff --git a/src/main.cpp b/src/main.cpp
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -886,8 +886,27 @@
             }
 
             if (result == false) {
-                fmt::print(stderr, "Error recompiling {}\n", new_func.name);
-                std::exit(EXIT_FAILURE);
+                // A static function is inferred by the recompiler from a jump
+                // target, not declared by the symbol map. If it will not
+                // recompile, the inference was wrong -- the target is data --
+                // and no symbol map can correct it, because the map never
+                // mentioned the function. Stopping the whole build over one
+                // lets a single mislabelled byte range block an entire game.
+                //
+                // The partial body is already written and cannot be taken back,
+                // so close it: the statements emitted so far are complete, only
+                // the terminator is missing, and an unbalanced brace breaks the
+                // whole file. Any label a surviving `goto` needs is added by
+                // tools/candidate-map/fix_dangling_labels.py, which knows which
+                // ones are actually missing.
+                //
+                // Carry on afterwards. If the target really was code, the call
+                // fails at run time with a specific "Failed to find function at
+                // 0x...", which is far more localised than having no build.
+                fmt::print(stderr, "Warning: discarding static function {} "
+                                   "(target is probably data)\n", new_func.name);
+                fmt::print(current_output_file, "\n    do_break(0x{:08X});\n;}}\n", new_func.vram);
+                continue;
             }
         }
     }
