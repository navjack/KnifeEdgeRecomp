diff --git a/src/main.cpp b/src/main.cpp
index 669c4a1..141013e 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -886,8 +886,20 @@ int main(int argc, char** argv) {
             }
 
             if (result == false) {
-                fmt::print(stderr, "Error recompiling {}\n", new_func.name);
-                std::exit(EXIT_FAILURE);
+                // A static function is inferred by the recompiler from a jump
+                // target, not declared by the symbol map. If it will not
+                // recompile, the inference was wrong -- the target is data --
+                // and no symbol map can correct it, because the map never
+                // mentioned the function. Stopping the whole build over one
+                // lets a single mislabelled byte range block an entire game.
+                //
+                // Warn and carry on. If the target really was code, the call
+                // fails at run time with a specific "Failed to find function at
+                // 0x..." instead, which is a far more localised problem than
+                // having no build at all.
+                fmt::print(stderr, "Warning: discarding static function {} "
+                                   "(target is probably data)\n", new_func.name);
+                continue;
             }
         }
     }
