# Upstream checkouts and build products are reproducible from UPSTREAM_PINS.txt.
/build/
/upstream/

# Copyrighted game data is never committed.
/rom/
*.z64
*.n64
*.v64

# Recompiler output, regenerated by scripts/recompile.sh.
/generated/
/generated-candidate/

# Splat disassembly workspace, regenerated by scripts/split_rom.sh.
# These are root-anchored on purpose: native/frontend/assets/ is tracked.
/asm/
/assets/
/decomp/build/

# Reverse-engineering metadata that has not been reviewed.
/decomp/*.candidate.syms.toml

# Packaged bundles are build output.
/*.app/

# Local tooling
/.tools-venv/
/.knife-edge/
.DS_Store
*.temp

# Go tool binaries (built by scripts/recover_map.sh)
/tools/map-recovery/map-recovery
/tools/recomp-boundary-audit/recomp-boundary-audit
